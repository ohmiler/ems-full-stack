# คัดลอกเป็น .env แล้วแก้ค่า หรือรัน `npm run setup` เพื่อสร้างอัตโนมัติ
API_PORT=3001
# ต้องตั้งค่าเป็นสตริงสุ่มยาว ๆ (server จะไม่ start ถ้าไม่มี)
JWT_SECRET=
# บัญชีผู้ดูแลระบบที่ `npm run seed` จะสร้างให้
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ตำแหน่งไฟล์ฐานข้อมูล (ค่าเริ่มต้น: server/data/ems.db)
# DB_PATH=
